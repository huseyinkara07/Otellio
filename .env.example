# Backend entegrasyonu: Supabase (Postgres)
# Gercek deger .env.local icinde tutulur (.env.local git'e commit edilmez).
# Supabase Dashboard > Project Settings > Database > Connection pooling
SUPABASE_DB_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth (SSR) icin gerekli genel (public) degerler.
# Supabase Dashboard > Project Settings > API sayfasindan alinir.
# Bu degerler tarayiciya gonderilir (NEXT_PUBLIC_), bu yuzden anon key
# gizli bir sir degildir; Row Level Security ile korunmalidir.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Haftalik e-posta raporu (app/api/cron/weekly-report).
# CRON_SECRET: cron rotasini disariya kapatan rastgele uzun bir deger;
# Vercel'de tanimlanirsa cron cagrilarina otomatik olarak eklenir.
# RESEND_API_KEY: https://resend.com API anahtari (sunucu tarafi sir).
# REPORT_FROM_EMAIL: dogrulanmis gonderici, ör. "Otellio <rapor@otellio.com>"
CRON_SECRET="<rastgele-uzun-deger>"
RESEND_API_KEY="<resend-api-key>"
REPORT_FROM_EMAIL="Otellio <rapor@otellio.com>"

# E-posta icindeki panel linki icin site adresi (tanimsizsa https://otellio.com).
NEXT_PUBLIC_SITE_URL="https://otellio.com"
